# prompton-home — static landing. ${APP_URL} / ${DOCS_URL} are substituted by the nginx image's envsubst at start.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/html text/css application/javascript text/plain image/svg+xml;

  location = /health { default_type text/plain; return 200 "ok\n"; }

  # The agent reference is versioned with the app, not the landing.
  location = /docs/agent { return 302 ${DOCS_URL}/agent; }
  location ~ ^/docs(/.*)?$ { return 302 ${DOCS_URL}$1; }

  # The CLI installer lives in the prompton-cli repository; this site only points at it.
  location = /install.sh { return 302 https://raw.githubusercontent.com/polimo-dev/prompton-cli/main/install.sh; }
  location = /uninstall.sh { return 302 https://raw.githubusercontent.com/polimo-dev/prompton-cli/main/uninstall.sh; }

  location / {
    try_files $uri $uri/ =404;
    add_header Cache-Control "public, max-age=300";
  }
}
